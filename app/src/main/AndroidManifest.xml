<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the user exempt the VPN from battery optimisation (Realme/OPPO, Xiaomi/Redmi, Samsung kill background VPNs). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Permissions declared by the ics-openvpn library that this app does not need -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />

    <!-- Lets the split-tunnelling screen list launchable apps without QUERY_ALL_PACKAGES -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".FreeVpnApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.FreeGlobalVPN"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        tools:replace="android:name,android:icon,android:roundIcon,android:label,android:theme,android:allowBackup,android:appCategory"
        android:appCategory="productivity"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.FreeGlobalVPN.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The OpenVPN service opens "<package>.activities.MainActivity" from its notification -->
        <activity-alias
            android:name=".activities.MainActivity"
            android:exported="false"
            android:targetActivity=".MainActivity" />

        <!-- Remove ics-openvpn's remote-control API & extra entry points: other apps must not control this VPN -->
        <service android:name="de.blinkt.openvpn.api.ExternalOpenVPNService" tools:node="remove" />
        <activity android:name="de.blinkt.openvpn.api.GrantPermissionsActivity" tools:node="remove" />
        <activity android:name="de.blinkt.openvpn.api.ConfirmDialog" tools:node="remove" />
        <activity android:name="de.blinkt.openvpn.api.RemoteAction" tools:node="remove" />
        <activity-alias android:name="de.blinkt.openvpn.api.ConnectVPN" tools:node="remove" />
        <activity-alias android:name="de.blinkt.openvpn.api.DisconnectVPN" tools:node="remove" />
        <activity-alias android:name="de.blinkt.openvpn.api.PauseVPN" tools:node="remove" />
        <activity-alias android:name="de.blinkt.openvpn.api.ResumeVPN" tools:node="remove" />
        <activity-alias android:name="de.blinkt.openvpn.api.SetDefaultVPN" tools:node="remove" />
        <receiver android:name="de.blinkt.openvpn.OnBootReceiver" tools:node="remove" />
        <activity android:name="de.blinkt.openvpn.LaunchVPN" android:exported="false" tools:replace="android:exported" />
        <activity android:name="de.blinkt.openvpn.activities.NotImplemented" android:exported="false" tools:replace="android:exported" />
        <!-- The engine opens these from its notification / credential prompts. They are declared only in the
             (unused) skeleton manifest, so define them here and route them to the app's main screen.
             An activity-alias without targetActivity makes Android reject the whole APK. -->
        <activity-alias
            android:name="de.blinkt.openvpn.activities.LogWindow"
            android:exported="false"
            android:targetActivity=".MainActivity" />
        <activity-alias
            android:name="de.blinkt.openvpn.activities.Req"
            android:exported="false"
            android:targetActivity=".MainActivity" />
    </application>
</manifest>
