<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!-- VPN Gate's list API is also served over plain HTTP; used only as a fallback when HTTPS is blocked. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">www.vpngate.net</domain>
    </domain-config>
</network-security-config>
